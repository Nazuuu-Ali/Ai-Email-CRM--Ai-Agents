    {
      "parameters": {
        "jsCode": "try {\n  // AI Agent ka raw output retrieve karna\n  let rawOutput = $input.first().json.output || \"\";\n\n  // Markdown code blocks ko clean karna (```json ... ``` ko remove karna)\n  let cleanJsonString = rawOutput\n    .replace(/^```json\\s*/i, \"\")\n    .replace(/^```\\s*/i, \"\")\n    .replace(/\\s*```$/, \"\")\n    .trim();\n\n  // JSON parse karna\n  const parsedData = JSON.parse(cleanJsonString);\n\n  return [{\n    json: {\n      intent: parsedData.intent || \"General\",\n      urgency: parsedData.urgency || \"Medium\",\n      sentiment: parsedData.sentiment || \"Neutral\",\n      summary: parsedData.summary || \"No summary provided\",\n      suggested_reply: parsedData.suggested_reply || \"Thank you for reaching out.\"\n    }\n  }];\n} catch (error) {\n  // Graceful fallback agar parsing fail ho jaye\n  return [{\n    json: {\n      intent: \"General\",\n      urgency: \"Medium\",\n      sentiment: \"Neutral\",\n      summary: \"Parsing Error\",\n      suggested_reply: \"Thank you for reaching out.\"\n    }\n  }];\n}"
      },
