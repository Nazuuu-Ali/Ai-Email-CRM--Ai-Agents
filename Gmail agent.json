      "parameters": {
        "promptType": "define",
        "text": "=Analyze this incoming email and return JSON format only:\n\nSubject: {{ $json.subject }}\nBody: {{ $json.snippet }}\n\nRequired JSON format:\n{\n  \"intent\": \"Sales Inquiry / Support / General\",\n  \"urgency\": \"High / Medium / Low\",\n  \"summary\": \"Short summary\",\n  \"suggested_reply\": \"Professional draft reply\"\n}",
        "options": {
          "systemMessage": "=You are an advanced enterprise AI Email Classification & Response Agent.\n\nAnalyze the incoming email provided below and output ONLY a valid JSON object.\n\nEmail Subject: {{ $json.subject || \"No Subject\" }}\nEmail Body: {{ $json.textAsSimple || $json.snippet || \"No Content\" }}\n\nOutput format:\n{\n  \"intent\": \"Sales Inquiry | Support | Refund | General / Spam\",\n  \"urgency\": \"High | Medium | Low\",\n  \"sentiment\": \"Positive | Neutral | Negative\",\n  \"summary\": \"Concise 1-sentence summary of the email\",\n  \"suggested_reply\": \"Write a professional, helpful, and concise response to the customer.\"\n}"
        }
      },
